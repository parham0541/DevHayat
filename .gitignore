# ==========================================

# DevHayat - Git Ignore

# ==========================================

# Dependencies

node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js

.next/
out/

# Production / Build

build/

# Testing

coverage/

# Environment variables & secrets

.env
.env.*
!.env.example

# Vercel

.vercel/

# Logs

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# TypeScript

*.tsbuildinfo
next-env.d.ts

# OS / Editor files

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Certificates / private keys

*.pem
*.key
*.crt

# Temporary files

*.tmp
*.temp
*.swp
*.swo
*~

# Archives / backups

*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Local / personal files

cookies.txt
camand.txt
parham.txt

# Database local files

*.db
*.sqlite
*.sqlite3

